# This environment variable is used in Production and Preview environments to deploy your Convex project
# This variable is not needed in development.
# You can create a Production or Preview deploy key at https://dashboard.convex.dev/project/settings#production-deploy-keys
CONVEX_DEPLOY_KEY=

# Public Convex URL used by the frontend and auth bridge.
NEXT_PUBLIC_CONVEX_URL=

# Site URL for Convex Better Auth callbacks (usually Convex site URL in local/dev setup).
NEXT_PUBLIC_CONVEX_SITE_URL=

# App URL used by Better Auth for verification/reset callback links.
SITE_URL=http://localhost:3000

# Better Auth secret (generate with `npx @better-auth/cli@latest secret`).
BETTER_AUTH_SECRET=

# Optional email sender for Resend-backed emails.
RESEND_FROM_EMAIL="Tascboard <onboarding@resend.dev>"
